---
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Сторінку не знайдено | Fight Lions" noindex>
  <section class="container nf">
    <p class="code display">404</p>
    <h1 class="display">Сторінку не знайдено</h1>
    <p>Можливо, посилання застаріло. Поверніться на головну — там розклад і контакти.</p>
    <Button href="/">На головну</Button>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: 20px;
    padding-block: 96px;
  }

  .code {
    color: var(--yellow);
    font-size: clamp(80px, 20vw, 160px);
    line-height: 0.9;
  }

  h1 {
    font-size: clamp(32px, 7vw, 56px);
  }

  p:not(.code) {
    max-width: 480px;
    color: var(--text-secondary);
  }
</style>
