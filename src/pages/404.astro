---
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Сторінку не знайдено | Fight Lions" noindex>
  <section class="container nf">
    <p class="code display">404</p>
    <h1 class="display">Сторінку не знайдено</h1>
    <p>Можливо, посилання застаріло. Поверніться на головну — там розклад і контакти.</p>
    <Button href="/">На головну</Button>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    padding-block: 96px;
  }

  .code {
    color: var(--yellow);
    font-size: var(--fs-error-code);
    line-height: 0.9;
  }

  h1 {
    font-size: var(--fs-page-title);
  }

  p:not(.code) {
    max-width: var(--measure-md);
    color: var(--text-secondary);
  }
</style>
