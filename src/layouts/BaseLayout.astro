---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
---

<!doctype html>
<html lang="uk">
  <head>
    <SEO {...Astro.props} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      До основного вмісту
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
