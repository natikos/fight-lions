---
import { Image } from 'astro:assets';

interface Props {
  index: number;
  title: string;
  description: string;
  tags: string[];
  image: ImageMetadata;
  alt: string;
  position: string;
}

const { index, title, description, tags, image, alt, position } = Astro.props;
---

<article class="card reveal">
  <Image
    src={image}
    {alt}
    widths={[480, 720, 960]}
    sizes="(min-width: 1100px) 33vw, (min-width: 768px) 50vw, 100vw"
    style={`object-position:${position}`}
    loading="lazy"
  />
  <span class="card__num" aria-hidden="true">
    {String(index).padStart(2, '0')}
  </span>
  <div class="card__body">
    <div class="card__line"></div>
    <h3 class="display card__title">{title}</h3>
    <p class="card__text">{description}</p>
    <ul class="tags">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  </div>
</article>

<style>
  .card {
    position: relative;
    overflow: hidden;
    min-height: 400px;
    border: 1px solid var(--line-photo);
    background: var(--bg-base);
  }

  .card :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .card:hover :global(img) {
    transform: scale(1.05);
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bg-base) 10%, transparent) 25%,
      color-mix(in srgb, var(--bg-base) 92%, transparent) 100%
    );
  }

  .card__num {
    position: absolute;
    z-index: 1;
    top: 16px;
    left: 20px;
    color: var(--yellow);
    font: 500 12px var(--font-mono);
    letter-spacing: 0.12em;
    text-shadow: 0 1px 6px color-mix(in srgb, var(--black) 80%, transparent);
  }

  .card__body {
    position: absolute;
    z-index: 1;
    inset: auto 0 0;
    padding: var(--space-6) var(--space-5);
  }

  .card__line {
    width: 48px;
    height: 2px;
    margin-bottom: var(--space-4);
    background: var(--yellow);
    transition: width 0.3s;
  }

  .card:hover .card__line {
    width: 96px;
  }

  .card__title {
    font-size: var(--fs-card-title);
    line-height: 1;
  }

  .card__text {
    margin-top: var(--space-2);
    color: var(--text-secondary);
    font-size: var(--fs-md);
    line-height: 1.5;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: var(--space-1) var(--space-2);
    border: 1px solid color-mix(in srgb, var(--text) 30%, transparent);
    background: color-mix(in srgb, var(--bg-base) 55%, transparent);
    font: 500 11px var(--font-mono);
    letter-spacing: 0.04em;
  }

  @media (min-width: 768px) {
    .card {
      min-height: 460px;
    }

    .card__text {
      min-height: 3em;
    }

    .card__body {
      padding: var(--space-6) var(--space-6);
    }
  }

  @media (min-width: 1100px) {
    .tags {
      min-height: 62px;
      align-content: flex-start;
    }
  }
</style>
