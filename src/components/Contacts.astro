---
import { Image } from 'astro:assets';
import logo from '../assets/logos/logo-fight-lions.png';
import { MESSENGERS, SITE, SOCIALS } from '../data/site';
import Button from './Button.astro';
import OrbitRings from './OrbitRings.astro';
import SocialLink from './SocialLink.astro';
---

<section id="contacts" class="contacts" aria-labelledby="contacts-title">
  <div class="container inner">
    <p class="eyebrow">06 / ЗАПИС І КОНТАКТИ</p>

    <div class="emblem" aria-hidden="true">
      <OrbitRings />
      <Image src={logo} alt="" width={340} height={340} densities={[1, 2]} loading="lazy" />
    </div>

    <h2 id="contacts-title" class="display title">
      Перше заняття
      <br />
      <span class="outline">безкоштовно</span>
    </h2>
    <p class="lead">
      Зателефонуйте або напишіть — підкажемо найближчий зал і групу. Власне спорядження не потрібне.
    </p>

    <div class="actions">
      <Button href={`tel:${SITE.phone.href}`} size="lg" class="actions__phone">
        {SITE.phone.display}
      </Button>
      <div class="actions__messengers">
        {MESSENGERS.map((m) => (
          <SocialLink social={m} size={60} />
        ))}
      </div>
    </div>

    <p class="socials__title">МИ В СОЦМЕРЕЖАХ</p>
    <div class="socials">
      {SOCIALS.map((s) => (
        <SocialLink social={s} variant="label" size={48} />
      ))}
    </div>
  </div>
</section>

<style>
  .contacts {
    position: relative;
    overflow: hidden;
    border-top: 2px solid var(--yellow);
    background: var(--bg-contacts);
  }

  .inner {
    position: relative;
    padding-block: var(--section-space);
  }

  .eyebrow {
    margin-bottom: var(--space-4);
    color: var(--yellow);
    font: 500 13px var(--font-mono);
    letter-spacing: 0.08em;
  }

  .emblem {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(220px, 56vw);
    aspect-ratio: 1;
    margin: var(--space-4) 0 var(--space-3) auto;
    pointer-events: none;
  }

  .emblem img {
    position: relative;
    width: 52%;
    height: auto;
    animation: float 6s ease-in-out infinite;
    filter: drop-shadow(0 24px 30px color-mix(in srgb, var(--black) 60%, transparent));
  }

  .title {
    --outline-width: 1.5px;
    margin-bottom: var(--space-6);
    font-size: var(--fs-contacts-title);
    line-height: 0.88;
  }

  .lead {
    max-width: var(--measure-lg);
    margin-bottom: var(--space-7);
    padding-left: var(--space-5);
    border-left: 2px solid var(--yellow);
    font-size: var(--fs-lead);
    line-height: 1.55;
  }

  .actions {
    display: grid;
    gap: var(--space-3);
    margin-bottom: 36px;
  }

  .actions__messengers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .actions__messengers :global(.social) {
    width: 100%;
  }

  .socials__title {
    margin-bottom: var(--space-4);
    color: var(--text-muted);
    font: 500 12px var(--font-mono);
    letter-spacing: 0.14em;
  }

  .socials {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .socials :global(.social) {
    width: 100%;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-12px);
    }
  }

  @media (min-width: 700px) {
    .actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
      margin-bottom: 44px;
    }

    .actions__messengers {
      display: flex;
      gap: var(--space-4);
    }

    .actions__messengers :global(.social) {
      width: 60px;
    }

    .socials {
      display: flex;
      flex-wrap: wrap;
    }

    .socials :global(.social) {
      width: auto;
    }
  }

  @media (min-width: 900px) {
    .emblem {
      position: absolute;
      top: 60px;
      right: clamp(16px, 5vw, 70px);
      width: clamp(380px, 47vw, 680px);
      margin: 0;
    }

    .title {
      --outline-width: 2px;
    }
  }
</style>
