---
import { BENEFITS, BENEFITS_INTRO } from '../data/benefits';
import BenefitCard from './BenefitCard.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
---

<Section id="why" labelledby="why-title">
  <div class="container wrap">
    <SectionHeading id="why-title">Що ви отримуєте у Fight Lions</SectionHeading>
    <p class="intro">{BENEFITS_INTRO}</p>
    <ul class="grid">
      {BENEFITS.map((b) => (
        <BenefitCard {...b} />
      ))}
    </ul>
  </div>
</Section>

<style>
  .wrap {
    padding-block: var(--section-space);
  }

  .wrap :global(.title) {
    font-size: clamp(30px, 6vw, 40px);
  }

  .intro {
    max-width: 820px;
    margin-top: 12px;
    color: var(--text-secondary);
    font-size: clamp(16px, 2vw, 17px);
    line-height: 1.65;
  }

  .grid {
    display: grid;
    gap: 16px 40px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .grid :global(.benefit) {
    padding-bottom: 8px;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 32px;
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
