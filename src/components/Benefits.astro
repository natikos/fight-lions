---
import { BENEFITS, BENEFITS_INTRO } from '../data/benefits';
import BenefitCard from './BenefitCard.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import SectionIntro from './SectionIntro.astro';
---

<Section id="why" labelledby="why-title">
  <SectionHeading id="why-title" eyebrow="02 / ПЕРЕВАГИ">
    Що ви отримуєте у Fight Lions
  </SectionHeading>
  <SectionIntro>{BENEFITS_INTRO}</SectionIntro>
  <ul class="grid">
    {BENEFITS.map((b) => (
      <BenefitCard {...b} />
    ))}
  </ul>
</Section>

<style>
  .grid {
    display: grid;
    gap: var(--space-4) var(--space-10);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }

  .grid :global(.benefit) {
    padding-bottom: var(--space-2);
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-8);
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
