---
interface Props {
  href: string;
  size?: 'md' | 'lg';
  class?: string;
}

const { href, size = 'md', class: className } = Astro.props;
---

<a class:list={['btn', `btn--${size}`, className]} {href}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: var(--space-4) var(--space-6);
    background: var(--gradient-yellow);
    color: var(--bg-section);
    font: 600 var(--fs-15)/1.2 var(--font-body);
    text-align: center;
    text-decoration: none;
    transition: filter 0.2s;
  }

  .btn:hover {
    color: var(--bg-section);
    filter: brightness(1.08);
  }

  .btn--lg {
    padding: var(--space-5) var(--space-7);
    font-size: var(--fs-button-lg);
  }

  @media (min-width: 768px) {
    .btn--lg {
      padding: var(--space-5) var(--space-9);
    }
  }
</style>
