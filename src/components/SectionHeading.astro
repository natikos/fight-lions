---
interface Props {
  /** Section number and name, e.g. "01 / НАПРЯМКИ". */
  eyebrow?: string;
  id: string;
  size?: 'md' | 'lg';
}

const { eyebrow, id, size = 'md' } = Astro.props;
---

<div class="heading reveal">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 {id} class:list={['display', 'title', `title--${size}`]}>
    <slot />
  </h2>
</div>

<style>
  .eyebrow {
    margin-bottom: var(--space-4);
    color: var(--yellow);
    font: 500 13px var(--font-mono);
    letter-spacing: 0.08em;
  }

  .title {
    font-size: var(--fs-heading);
    line-height: 1;
    text-wrap: balance;
  }

  .title--lg {
    font-size: var(--fs-heading-lg);
  }
</style>
