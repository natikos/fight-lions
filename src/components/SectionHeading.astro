---
import Eyebrow from './Eyebrow.astro';

interface Props {
  /** Section number and name, e.g. "01 / НАПРЯМКИ". */
  eyebrow?: string;
  id: string;
  size?: 'md' | 'lg';
}

const { eyebrow, id, size = 'md' } = Astro.props;
---

<div class="heading reveal">
  {eyebrow && <Eyebrow text={eyebrow} />}
  <h2 {id} class:list={['display', 'title', `title--${size}`]}>
    <slot />
  </h2>
</div>

<style>
  .title {
    font-size: var(--fs-heading);
    line-height: 1;
    text-wrap: balance;
  }

  .title--lg {
    font-size: var(--fs-heading-lg);
  }
</style>
