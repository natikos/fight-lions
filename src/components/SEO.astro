---
import { SITE, SOCIALS } from '../data/site';
import { HALLS } from '../data/schedule';

interface Props {
  title?: string;
  description?: string;
  /** Hide the page from search engines (e.g. the 404 page). */
  noindex?: boolean;
}

const { title = SITE.title, description = SITE.description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-card.png', Astro.site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.fullName,
  alternateName: SITE.name,
  url: `${SITE.url}/`,
  logo: new URL('/icon-512.png', Astro.site).href,
  image: ogImage,
  sport: 'Рукопашний бій',
  description: SITE.description,
  telephone: SITE.phone.href,
  areaServed: 'Львів',
  sameAs: [...SOCIALS.flatMap((s) => (s.href ? [s.href] : [])), SITE.tournamentHub],
  location: HALLS.map((hall) => ({
    '@type': 'SportsActivityLocation',
    name: hall.venue,
    address: {
      '@type': 'PostalAddress',
      streetAddress: hall.street,
      addressLocality: hall.locality,
      addressCountry: 'UA',
    },
  })),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
<meta name="theme-color" content="#131517" />
<link rel="canonical" href={canonical} />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<meta property="og:type" content="website" />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Fight Lions — рукопашний бій у Львові" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
