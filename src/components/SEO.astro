---
import firaCyrillic700 from '@fontsource/fira-sans-extra-condensed/files/fira-sans-extra-condensed-cyrillic-700-normal.woff2?url';
import { SITE, SOCIALS } from '../data/site';
import { HALLS } from '../data/schedule';
import { NOINDEX } from '../utils/env';

/** schema.org day names, indexed like `DAYS` in the schedule (0 = Monday). */
const SCHEMA_DAYS = [
  'https://schema.org/Monday',
  'https://schema.org/Tuesday',
  'https://schema.org/Wednesday',
  'https://schema.org/Thursday',
  'https://schema.org/Friday',
  'https://schema.org/Saturday',
];

const postalAddress = (hall: (typeof HALLS)[number]) => ({
  '@type': 'PostalAddress',
  streetAddress: hall.street,
  addressLocality: hall.locality,
  addressRegion: 'Львівська область',
  addressCountry: 'UA',
});

/** One entry per day a hall trains, from the first slot's start to the last slot's end. */
const openingHours = (hall: (typeof HALLS)[number]) =>
  hall.blocks.flatMap((block) => {
    const times = block.slots.flatMap((slot) => slot.time.split('–'));
    return {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: block.days.map((d) => SCHEMA_DAYS[d]),
      opens: times[0],
      closes: times[times.length - 1],
    };
  });

interface Props {
  title?: string;
  description?: string;
  /** Hide the page from search engines (e.g. the 404 page). */
  noindex?: boolean;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const noindex = Astro.props.noindex || NOINDEX;
const origin = Astro.site!.origin;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-card.png', Astro.site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  '@id': `${origin}/#organization`,
  name: SITE.fullName,
  alternateName: SITE.name,
  url: `${origin}/`,
  logo: new URL('/icon-512.png', Astro.site).href,
  image: ogImage,
  sport: 'Рукопашний бій',
  description: SITE.description,
  telephone: SITE.phone.href,
  address: postalAddress(HALLS[0]),
  areaServed: { '@type': 'City', name: 'Львів' },
  sameAs: [...SOCIALS.flatMap((s) => (s.href ? [s.href] : [])), SITE.tournamentHub],
  location: HALLS.map((hall, i) => ({
    '@type': 'SportsActivityLocation',
    '@id': `${origin}/#hall-${i + 1}`,
    name: hall.venue,
    telephone: SITE.phone.href,
    address: postalAddress(hall),
    openingHoursSpecification: openingHours(hall),
  })),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={
    NOINDEX
      ? 'noindex, nofollow'
      : noindex
        ? 'noindex,follow'
        : 'index,follow,max-image-preview:large'
  }
/>
<meta name="theme-color" content="#131517" />
<link rel="canonical" href={canonical} />

<!-- Display font for the hero h1: without this it waits on the stylesheet. -->
<link rel="preload" href={firaCyrillic700} as="font" type="font/woff2" crossorigin />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<meta property="og:type" content="website" />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Fight Lions — рукопашний бій у Львові" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
