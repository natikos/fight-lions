---
import { DAYS, GROUPS, HALLS, SPARRING, hallAddress, type Group } from '../data/schedule';
import { SITE } from '../data/site';
import Button from './Button.astro';
import HallTitle from './HallTitle.astro';
import ScheduleSlot from './ScheduleSlot.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';

const num = (i: number) => String(i + 1).padStart(2, '0');
const dayLabel = (days: number[]) => days.map((d) => DAYS[d]).join(' · ');
const groupKeys = Object.keys(GROUPS) as Group[];
---

<Section id="training" variant="panel" labelledby="training-title">
  <div class="container wrap">
    <div class="head">
      <SectionHeading id="training-title" eyebrow="05 / ТРЕНУВАННЯ" size="lg">
        Розклад по залах
      </SectionHeading>
      <Button href={`tel:${SITE.phone.href}`} class="head__btn">
        Записатися: {SITE.phone.display}
      </Button>
    </div>

    <ul class="legend">
      {groupKeys.map((g) => (
        <li class="legend__item" data-group={g}>
          {GROUPS[g]} група
        </li>
      ))}
    </ul>

    <!-- Compact list: phones and tablets -->
    <ol class="list">
      {HALLS.map((hall, i) => (
        <li class="list__hall">
          <HallTitle num={num(i)} title={hallAddress(hall)} note={hall.venue} />
          {hall.blocks.map((block) => (
            <div class="list__block">
              <p class="chip">{dayLabel(block.days)}</p>
              {block.slots.map((slot) => (
                <ScheduleSlot {...slot} />
              ))}
            </div>
          ))}
        </li>
      ))}
      <li class="list__hall">
        <HallTitle num="VS" title={SPARRING.title} note={SPARRING.note} />
        <div class="list__block">
          <p class="chip">{DAYS[SPARRING.day]}</p>
          <ScheduleSlot time={SPARRING.time} label={SPARRING.label} />
        </div>
      </li>
    </ol>

    <!-- Weekly grid: desktop -->
    <table class="grid">
      <caption class="sr-only">Розклад тренувань по залах і днях тижня</caption>
      <thead>
        <tr>
          <td></td>
          {DAYS.map((d, i) => (
            <th scope="col" class:list={{ sat: i === 5 }}>
              {d.toUpperCase()}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {HALLS.map((hall, i) => (
          <tr>
            <th scope="row">
              <HallTitle num={num(i)} title={hallAddress(hall)} note={hall.venue} />
            </th>
            {DAYS.map((_, day) => {
              const block = hall.blocks.find((b) => b.days.includes(day));
              return (
                <td>
                  {block?.slots.map((slot) => (
                    <ScheduleSlot {...slot} />
                  ))}
                </td>
              );
            })}
          </tr>
        ))}
        <tr class="sparring">
          <th scope="row">
            <HallTitle num="VS" title={SPARRING.title} note={SPARRING.note} />
          </th>
          {DAYS.map((_, day) => (
            <td class:list={{ sparring__cell: day === SPARRING.day }}>
              {day === SPARRING.day && <ScheduleSlot time={SPARRING.time} label={SPARRING.label} />}
            </td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>
</Section>

<style>
  .wrap {
    padding-block: var(--section-space);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .head__btn {
    width: 100%;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0 0 var(--space-5);
    padding: 0 0 var(--space-4);
    border-bottom: 2px solid var(--yellow);
    list-style: none;
  }

  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    font: 500 12px var(--font-mono);
  }

  .legend__item::before {
    content: '';
    width: 3px;
    height: 14px;
    background: var(--group);
  }

  .legend__item[data-group='junior'] {
    --group: var(--group-junior);
  }

  .legend__item[data-group='middle'] {
    --group: var(--group-middle);
  }

  .legend__item[data-group='senior'] {
    --group: var(--group-senior);
  }

  /* ---- Compact list ---- */
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list__hall {
    padding: var(--space-5) 0;
    border-top: 1px dashed var(--line);
  }

  .list__hall:first-child {
    border-top: 0;
  }

  .list__block {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .chip {
    justify-self: start;
    padding: var(--space-1) var(--space-2);
    background: var(--yellow);
    color: var(--bg-section);
    font: 500 12px var(--font-mono);
    letter-spacing: 0.06em;
  }

  @media (min-width: 560px) {
    .list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 var(--space-8);
    }

    .list__hall:nth-child(2) {
      border-top: 0;
    }
  }

  @media (min-width: 700px) {
    .head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .head__btn {
      width: auto;
    }
  }

  /* ---- Weekly grid ---- */
  .grid {
    display: none;
  }

  @media (min-width: 1100px) {
    .list {
      display: none;
    }

    .grid {
      display: table;
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
    }

    .grid thead {
      border-bottom: 2px solid var(--yellow);
    }

    .grid th[scope='col'] {
      padding: var(--space-3) var(--space-3) var(--space-3);
      color: var(--text-muted);
      font: 500 12px var(--font-mono);
      letter-spacing: 0.14em;
      text-align: left;
    }

    .grid th.sat {
      color: var(--yellow);
    }

    .grid td:first-child,
    .grid th[scope='row'] {
      width: 260px;
    }

    .grid tbody tr {
      border-top: 1px solid var(--line);
    }

    .grid th[scope='row'],
    .grid td {
      padding: var(--space-4) var(--space-3);
      font-weight: 400;
      text-align: left;
      vertical-align: top;
      transition: background 0.2s;
    }

    .grid td:hover {
      background: color-mix(in srgb, var(--blue) 8%, transparent);
    }

    .grid td :global(.slot) {
      margin-bottom: var(--space-3);
    }

    .grid tbody tr:last-child {
      border-bottom: 1px solid var(--line);
    }

    .sparring__cell {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--blue) 40%, transparent),
        color-mix(in srgb, var(--blue) 12%, transparent)
      );
      box-shadow: inset 0 0 0 1px var(--blue);
    }

    .sparring__cell :global(.slot) {
      margin: 0;
      border-color: var(--text);
    }
  }
</style>
