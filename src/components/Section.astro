---
import Rule from './Rule.astro';

interface Props {
  id: string;
  /** `panel` = gradient background with yellow→blue separators above and below. */
  variant?: 'flat' | 'panel';
  /** `false` when the section lays out its own full-bleed content (e.g. Grading). */
  contained?: boolean;
  labelledby?: string;
  class?: string;
}

const { id, variant = 'flat', contained = true, labelledby, class: className } = Astro.props;
---

<section
  {id}
  aria-labelledby={labelledby}
  class:list={['section', `section--${variant}`, className]}
>
  {variant === 'panel' && <Rule />}
  {contained ? (
    <div class="container inner">
      <slot />
    </div>
  ) : (
    <slot />
  )}
  {variant === 'panel' && <Rule />}
</section>

<style>
  .section {
    border-bottom: 1px solid var(--line-subtle);
  }

  .section--panel {
    background: var(--bg-panel-gradient);
  }

  .inner {
    padding-block: var(--section-space);
  }
</style>
