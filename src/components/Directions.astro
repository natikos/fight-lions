---
import { DIRECTIONS } from '../data/directions';
import DirectionCard from './DirectionCard.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
---

<Section id="about" variant="panel" labelledby="about-title">
  <div class="container wrap">
    <div class="intro">
      <SectionHeading id="about-title" eyebrow="01 / НАПРЯМКИ">
        Боротьба, удари, самооборона — в одній системі
      </SectionHeading>
      <p class="intro__text">
        Удари, кидки, боротьба в стійці й партері, затримання та захист від зброї — без кіношних
        прийомів. Техніки відкриваються поступово, за рівнем пояса.
      </p>
    </div>
    <div class="grid">
      {DIRECTIONS.map((d, i) => (
        <DirectionCard index={i + 1} {...d} />
      ))}
    </div>
  </div>
</Section>

<style>
  .wrap {
    padding-block: var(--section-space);
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 24px;
    margin-bottom: 32px;
  }

  .intro :global(.title) {
    max-width: 760px;
  }

  .intro__text {
    max-width: 400px;
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.6;
  }

  .grid {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .grid > :global(:first-child) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: 1.25fr 1fr 1fr;
    }

    .grid > :global(:first-child) {
      grid-column: auto;
    }
  }
</style>
