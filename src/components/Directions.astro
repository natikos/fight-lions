---
import { DIRECTIONS } from '../data/directions';
import DirectionCard from './DirectionCard.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
---

<Section id="about" variant="panel" labelledby="about-title">
  <div class="container wrap">
    <div class="intro">
      <SectionHeading id="about-title" eyebrow="01 / НАПРЯМКИ">
        Боротьба, удари, самооборона — в одній системі
      </SectionHeading>
      <p class="intro__text">
        Без кіношних прийомів — лише те, що працює і на вулиці, і на змаганнях: за правилами та без
        правил. Удари, кидки, боротьба в стійці й партері, затримання. Техніки відкриваються
        поступово, за рівнем пояса.
      </p>
    </div>
    <div class="grid">
      {DIRECTIONS.map((d, i) => (
        <DirectionCard index={i + 1} {...d} />
      ))}
    </div>
  </div>
</Section>

<style>
  .wrap {
    padding-block: var(--section-space);
  }

  .intro {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .intro :global(.title) {
    max-width: none;
  }

  .intro__text {
    max-width: var(--measure-xl);
    color: var(--text-secondary);
    font-size: var(--fs-base);
    line-height: 1.6;
  }

  .grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .grid > :global(:first-child) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: 1.25fr 1fr 1fr;
    }

    .grid > :global(:first-child) {
      grid-column: auto;
    }
  }
</style>
