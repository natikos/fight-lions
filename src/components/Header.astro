---
import { Image } from 'astro:assets';
import logo from '../assets/logos/logo-fight-lions.png';
import { MESSENGERS, NAV, SITE } from '../data/site';
import SocialLink from './SocialLink.astro';
---

<header class="header">
  <div class="container bar">
    <a class="brand" href="#top" aria-label={`${SITE.name} — на початок сторінки`}>
      <Image
        src={logo}
        alt=""
        width={60}
        height={60}
        densities={[1.5, 2]}
        class="brand__logo"
        loading="eager"
      />
      <span>
        <span class="brand__name">{SITE.name}</span>
        <span class="brand__sub">{SITE.shortOrg.toUpperCase()}</span>
      </span>
    </a>

    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Відкрити меню"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Основна навігація">
      {NAV.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="contact">
      <a class="contact__phone" href={`tel:${SITE.phone.href}`}>
        {SITE.phone.display}
      </a>
      {MESSENGERS.map((m) => (
        <SocialLink social={m} />
      ))}
    </div>
  </div>
</header>

<script is:inline>
  const header = document.querySelector('.header');
  if (header) header.dataset.js = '';
</script>

<script>
  const header = document.querySelector<HTMLElement>('.header');
  const burger = header?.querySelector<HTMLButtonElement>('.burger');

  const setOpen = (open: boolean) => {
    if (!header || !burger) return;
    header.toggleAttribute('data-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Закрити меню' : 'Відкрити меню');
  };

  burger?.addEventListener('click', () => setOpen(!header?.hasAttribute('data-open')));
  header
    ?.querySelectorAll('.nav a')
    .forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.hasAttribute('data-open')) {
      setOpen(false);
      burger?.focus();
    }
  });
</script>

<style>
  .header {
    border-bottom: 1px solid var(--line-subtle);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand__logo {
    width: var(--touch-target);
    height: var(--touch-target);
  }

  .brand__name {
    display: block;
    font: 700 var(--fs-22)/1 var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .brand__sub {
    display: none;
    margin-top: var(--space-1);
    color: var(--text-muted);
    font: 400 var(--fs-12) var(--font-mono);
    letter-spacing: 0.04em;
  }

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    width: var(--touch-target);
    height: var(--touch-target);
    padding: 0 var(--space-3);
    border: 1px solid var(--line-control);
    background: none;
    cursor: pointer;
  }

  .burger span {
    height: 2px;
    background: var(--text);
  }

  .burger span:last-child {
    width: 60%;
    background: var(--yellow);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    grid-column: 1 / -1;
    padding-block: var(--space-2);
  }

  .nav a {
    padding: var(--space-3) 0;
    border-bottom: 2px solid transparent;
    color: var(--text);
    font: 500 var(--fs-15) var(--font-body);
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .nav a:hover {
    border-color: var(--yellow);
    color: var(--text);
  }

  .contact {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
  }

  .contact__phone {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    background: var(--gradient-yellow);
    color: var(--bg-section);
    font: 600 var(--fs-14) var(--font-body);
    text-decoration: none;
  }

  .contact__phone:hover {
    color: var(--bg-section);
  }

  @media (min-width: 700px) {
    .contact__phone {
      flex: 0 1 360px;
    }
  }

  /* With JS the nav collapses behind the burger on small screens. */
  .header[data-js] .burger {
    display: flex;
  }

  .header[data-js] .nav {
    display: none;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--line-subtle);
  }

  .header[data-js][data-open] .nav {
    display: flex;
  }

  @media (min-width: 1100px) {
    .bar {
      display: flex;
      justify-content: space-between;
      gap: var(--space-6);
      padding-block: var(--space-5);
    }

    .brand {
      gap: var(--space-4);
    }

    .brand__logo {
      width: 60px;
      height: 60px;
    }

    .brand__name {
      font-size: var(--fs-24);
    }

    .brand__sub {
      display: block;
    }

    .header[data-js] .burger {
      display: none;
    }

    .nav,
    .header[data-js] .nav {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      gap: var(--space-6);
      padding: 0;
      border: 0;
    }

    .nav a {
      padding: var(--space-2) 0;
    }

    .contact {
      gap: var(--space-4);
      padding: 0;
    }

    .contact__phone {
      flex: none;
      min-height: 0;
      margin-right: var(--space-2);
      background: none;
      color: var(--text);
      font-size: var(--fs-16);
    }

    .contact__phone:hover {
      color: var(--yellow);
    }
  }
</style>
