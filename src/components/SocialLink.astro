---
import type { Social } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  social: Social;
  /** `icon` = square icon-only button; `label` = icon + text. */
  variant?: 'icon' | 'label';
  size?: number;
  class?: string;
}

const { social, variant = 'icon', size = 44, class: className } = Astro.props;
const external = social.href?.startsWith('http');
---

{social.href && (
  <a
    class:list={['social', `social--${social.id}`, `social--${variant}`, className]}
    href={social.href}
    aria-label={variant === 'icon' ? social.label : undefined}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    data-copy={social.copyText}
    style={`--size:${size}px`}
  >
    <Icon name={social.id} size={variant === 'icon' ? Math.round(size * 0.42) : 20} />
    {variant === 'label' && <span>{social.label}</span>}
  </a>
)}

<script>
  const COPIED_MS = 2000;
  const desktop = matchMedia('(hover: hover) and (pointer: fine)');

  document.addEventListener('click', async (event) => {
    const link = (event.target as Element).closest<HTMLElement>('[data-copy]');
    if (!link || !desktop.matches) return;
    event.preventDefault();
    try {
      await navigator.clipboard.writeText(link.dataset.copy!);
    } catch {
      return;
    }
    link.dataset.copied = '';
    setTimeout(() => delete link.dataset.copied, COPIED_MS);
  });
</script>

<style>
  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-width: var(--touch-target);
    height: var(--size);
    color: var(--white);
    font: 500 var(--fs-13) var(--font-mono);
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: filter 0.2s;
  }

  .social:hover {
    color: var(--white);
    filter: brightness(1.15);
  }

  .social[data-copy] {
    position: relative;
  }

  .social[data-copied]::after {
    content: 'Номер скопійовано';
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    padding: var(--space-2) var(--space-3);
    background: var(--black);
    color: var(--white);
    font: 500 var(--fs-13) var(--font-mono);
    white-space: nowrap;
    z-index: 1;
  }

  .social--icon {
    width: var(--size);
  }

  /* Brand fills are too light for white text; a scrim takes every one past AA. */
  .social--label {
    position: relative;
    padding-inline: var(--space-5);
  }

  .social--label::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--black) 22%, transparent);
  }

  .social--label > * {
    position: relative;
  }

  .social--telegram {
    background: var(--brand-telegram);
  }

  .social--viber {
    background: var(--brand-viber);
  }

  .social--instagram {
    background: var(--brand-instagram);
  }

  .social--youtube {
    background: var(--brand-youtube);
  }

  .social--facebook {
    background: var(--brand-facebook);
  }

  .social--tiktok {
    background: var(--belt-black);
    box-shadow:
      -2px -2px 0 var(--brand-tiktok-cyan),
      2px 2px 0 var(--brand-tiktok-red);
  }
</style>
