---
import { Image } from 'astro:assets';
import ceremony from '../assets/images/photo-grading-ceremony.jpg';
import { BELTS, BLACK_BELT } from '../data/belts';
import Belt from './Belt.astro';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
---

<Section id="grading" variant="panel" labelledby="grading-title" contained={false}>
  <div class="photo">
    <Image
      src={ceremony}
      alt="Атестація на пояси у Львівській обласній федерації рукопашного бою: учні з дипломами"
      widths={[640, 1000, 1600]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="photo__shade" aria-hidden="true"></div>
    <p class="container photo__label">АТЕСТАЦІЯ НА НОВИЙ ПОЯС</p>
  </div>

  <div class="container wrap">
    <div class="text">
      <SectionHeading id="grading-title" eyebrow="03 / ГРАДАЦІЯ">
        Від білого до чорного пояса
      </SectionHeading>
      <p>
        Шлях від білого до чорного пояса поділений на кю — ступені, кожен зі своїми вимогами. Щоб
        перейти на наступний, учень складає атестацію: це не формальність, а чесна перевірка того,
        чого навчили тренування.
      </p>
      <ul class="checks">
        <li>
          <strong>Фізична підготовка:</strong>
          <span>сила, витривалість, швидкість</span>
        </li>
        <li>
          <strong>Гнучкість:</strong>
          <span>рухливість і контроль тіла</span>
        </li>
        <li>
          <strong>Техніки:</strong>
          <span>удари, кидки, больові, захист</span>
        </li>
      </ul>
      <p>
        З кожним новим поясом техніки стають складнішими. Після коричневого пояса рахунок іде вже не
        на кю, а на дани — майстерські ступені чорного пояса.
      </p>
      <p class="note">Графік атестацій уточнюйте у тренера.</p>
    </div>

    <div class="table" role="table" aria-label="Система поясів">
      <div class="row row--head" role="row">
        <span class="col-title" role="columnheader">
          КЮ · ПОЯС
        </span>
        <span class="col-title" role="columnheader">
          БЕЗ СМУЖКИ
        </span>
        <span class="col-title" role="columnheader">
          ЗІ СМУЖКОЮ
        </span>
      </div>
      {BELTS.map((b, i) => (
        <div class:list={['row', { 'row--first': i === 0 }]} role="row">
          <div class="who" role="rowheader">
            <span class="name">{b.name}</span>
            <span class="kyu">{b.kyu} кю</span>
          </div>
          <div class="cell" role="cell">
            <Belt color={b.color} />
          </div>
          <div class="cell" role="cell">
            <Belt color={b.color} stripe={b.stripe} />
          </div>
        </div>
      ))}
      <div class="row row--black" role="row">
        <div class="who" role="rowheader">
          <span class="name">{BLACK_BELT.name}</span>
          <span class="kyu">дани</span>
        </div>
        <div class="cell cell--wide" role="cell" aria-colspan="2">
          <Belt color="black" />
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .photo {
    /* On the image and the shade, not the wrapper, so the label stays opaque. */
    --edge-fade: linear-gradient(
      90deg,
      transparent 0,
      var(--black) 7%,
      var(--black) 93%,
      transparent 100%
    );
    position: relative;
    max-width: var(--container-max);
    height: 200px;
    margin-inline: auto;
    overflow: hidden;
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    mask-image: var(--edge-fade);
    object-fit: cover;
    object-position: 50% 38%;
    filter: grayscale(0.45) contrast(1.05) brightness(0.8);
  }

  .photo__shade {
    position: absolute;
    inset: 0;
    mask-image: var(--edge-fade);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bg-panel-alt) 15%, transparent) 0%,
      color-mix(in srgb, var(--bg-panel-alt) 55%, transparent) 55%,
      var(--bg-grading-fade) 100%
    );
  }

  .photo__label {
    position: absolute;
    inset: auto 0 56px;
    color: var(--text);
    font: 500 var(--fs-11) var(--font-mono);
    letter-spacing: 0.14em;
  }

  .wrap {
    /* How far the panel rides up over the photo. */
    --overlap: var(--space-10);
    position: relative;
    display: grid;
    gap: var(--space-8);
    margin-top: calc(-1 * var(--overlap));
    padding-block: var(--space-10) var(--section-space);
  }

  .text {
    display: grid;
    gap: var(--space-4);
  }

  .text :global(.heading) {
    margin-bottom: var(--space-1);
  }

  .text p {
    color: var(--text-secondary);
    font-size: var(--fs-16);
    line-height: 1.6;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(104px, 0.9fr) 1fr 1fr;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
    transition: background 0.25s;
  }

  .row:not(.row--head):hover {
    background: var(--hover-wash);
  }

  .row--head {
    padding: 0 0 var(--space-2);
    border: 0;
  }

  .row--first {
    border-top: 2px solid var(--text);
  }

  .row--black {
    border-top: 2px solid var(--yellow);
    border-bottom: 1px solid var(--line);
  }

  .col-title,
  .kyu {
    font-family: var(--font-mono);
  }

  .col-title {
    color: var(--text-muted);
    font-size: var(--fs-12);
    letter-spacing: 0.06em;
  }

  .name {
    display: block;
    font: 700 clamp(16px, 4.4vw, 20px) / 1 var(--font-display);
    text-transform: uppercase;
  }

  .kyu {
    display: block;
    margin-top: var(--space-1);
    color: var(--yellow);
    font-size: var(--fs-11);
  }

  .row--black .name {
    color: var(--yellow);
  }

  .cell--wide {
    grid-column: 2 / -1;
  }

  .checks {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-3);
    border-left: 2px solid var(--yellow);
    color: var(--text-secondary);
  }

  .checks strong {
    color: var(--text);
    font-weight: 600;
  }

  .text p.note {
    color: var(--text-muted);
    font-size: var(--fs-14);
  }

  @media (min-width: 768px) {
    .photo {
      height: 360px;
    }

    .photo__label {
      bottom: 150px;
    }

    .row {
      grid-template-columns: 266px 1fr 1fr;
      gap: var(--space-5);
      padding: var(--space-3) 0;
    }

    /* Desktop: kyu and name sit side by side. */
    .who {
      display: grid;
      grid-template-columns: 96px 1fr;
      gap: var(--space-5);
      align-items: center;
    }

    .kyu {
      grid-column: 1;
      grid-row: 1;
      margin: 0;
      font-size: var(--fs-12);
    }

    .name {
      grid-column: 2;
      grid-row: 1;
    }

    .wrap {
      margin-top: calc(-1 * var(--overlap));
      padding-top: calc(var(--section-space) - var(--overlap));
    }
  }

  @media (min-width: 1100px) {
    .wrap {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-6);
    }

    .text {
      grid-column: 1 / span 4;
      align-content: start;
      align-self: start;
      position: sticky;
      top: var(--space-10);
    }

    .table {
      grid-column: 6 / span 7;
    }
  }
</style>
