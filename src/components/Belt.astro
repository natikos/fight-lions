---
import type { BeltColor } from '../data/belts';

interface Props {
  color: BeltColor;
  /** Draws a stripe near the end: the second, "striped" grade. */
  stripe?: BeltColor;
}

const { color, stripe } = Astro.props;
---

<div class="belt" style={`--belt:var(--belt-${color})`} data-color={color}>
  {stripe && <i class="tip" style={`--belt:var(--belt-${stripe})`}></i>}
</div>

<style>
  .belt {
    position: relative;
    width: 100%;
    height: 19px;
    background: var(--belt);
    box-shadow:
      0 7px 14px -4px color-mix(in srgb, var(--black) 65%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--white) 14%, transparent);
    transition: transform 0.25s;
  }

  /* Fabric sheen + stitching */
  .belt::before,
  .tip::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--white) 34%, transparent) 0,
        color-mix(in srgb, var(--white) 4%, transparent) 38%,
        color-mix(in srgb, var(--black) 5%, transparent) 62%,
        color-mix(in srgb, var(--black) 42%, transparent) 100%
      ),
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--black) 9%, transparent) 0 1px,
        color-mix(in srgb, var(--white) 5%, transparent) 1px 3px
      );
  }

  .belt::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(
          90deg,
          color-mix(in srgb, var(--black) 38%, transparent) 0 5px,
          transparent 5px 9px
        )
        left 0 top 4px / 100% 1px no-repeat,
      repeating-linear-gradient(
          90deg,
          color-mix(in srgb, var(--black) 38%, transparent) 0 5px,
          transparent 5px 9px
        )
        left 0 bottom 4px / 100% 1px no-repeat;
  }

  .belt[data-color='white']::after {
    opacity: 0.55;
  }

  .belt[data-color='black'] {
    box-shadow:
      0 7px 14px -4px color-mix(in srgb, var(--black) 80%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--white) 28%, transparent);
  }

  .belt[data-color='black']::after {
    background:
      repeating-linear-gradient(
          90deg,
          color-mix(in srgb, var(--white) 28%, transparent) 0 5px,
          transparent 5px 9px
        )
        left 0 top 4px / 100% 1px no-repeat,
      repeating-linear-gradient(
          90deg,
          color-mix(in srgb, var(--white) 28%, transparent) 0 5px,
          transparent 5px 9px
        )
        left 0 bottom 4px / 100% 1px no-repeat;
  }

  .tip {
    position: absolute;
    inset-block: -1px;
    right: 18px;
    z-index: 1;
    width: 12px;
    background: var(--belt);
    border-inline: 1px solid color-mix(in srgb, var(--black) 55%, transparent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--black) 35%, transparent);
  }

  @media (min-width: 768px) {
    .belt {
      height: 22px;
    }

    .tip {
      right: 34px;
      width: 16px;
    }
  }
</style>
