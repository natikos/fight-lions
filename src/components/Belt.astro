---
import type { BeltColor } from '../data/belts';

interface Props {
  color: BeltColor;
  /** Draws a stripe near the end: the second, "striped" grade. */
  stripe?: BeltColor;
}

const { color, stripe } = Astro.props;
---

<div class="belt" style={`--belt:var(--belt-${color})`} data-color={color}>
  {stripe && <i class="tip" style={`--belt:var(--belt-${stripe})`}></i>}
</div>

<style>
  .belt {
    position: relative;
    width: 100%;
    height: 19px;
    border-radius: 2px 7px 7px 2px;
    background: var(--belt);
    box-shadow:
      0 7px 14px -4px rgb(0 0 0 / 65%),
      inset 0 0 0 1px rgb(255 255 255 / 14%);
    transition: transform 0.25s;
  }

  /* Fabric sheen + stitching */
  .belt::before,
  .tip::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgb(255 255 255 / 34%) 0,
        rgb(255 255 255 / 4%) 38%,
        rgb(0 0 0 / 5%) 62%,
        rgb(0 0 0 / 42%) 100%
      ),
      repeating-linear-gradient(90deg, rgb(0 0 0 / 9%) 0 1px, rgb(255 255 255 / 5%) 1px 3px);
  }

  .belt::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(90deg, rgb(0 0 0 / 38%) 0 5px, transparent 5px 9px) left 0 top 4px /
        100% 1px no-repeat,
      repeating-linear-gradient(90deg, rgb(0 0 0 / 38%) 0 5px, transparent 5px 9px) left 0 bottom
        4px / 100% 1px no-repeat;
  }

  .belt[data-color='white']::after {
    opacity: 0.55;
  }

  .belt[data-color='black'] {
    box-shadow:
      0 7px 14px -4px rgb(0 0 0 / 80%),
      inset 0 0 0 1px rgb(255 255 255 / 28%);
  }

  .belt[data-color='black']::after {
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 28%) 0 5px, transparent 5px 9px) left 0 top
        4px / 100% 1px no-repeat,
      repeating-linear-gradient(90deg, rgb(255 255 255 / 28%) 0 5px, transparent 5px 9px) left 0
        bottom 4px / 100% 1px no-repeat;
  }

  .tip {
    position: absolute;
    inset-block: -1px;
    right: 18px;
    z-index: 1;
    width: 12px;
    background: var(--belt);
    border-inline: 1px solid rgb(0 0 0 / 55%);
    box-shadow: 0 0 8px rgb(0 0 0 / 35%);
  }

  @media (min-width: 768px) {
    .belt {
      height: 22px;
    }

    .tip {
      right: 34px;
      width: 16px;
    }
  }
</style>
