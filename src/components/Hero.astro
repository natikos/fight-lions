---
import { Image } from 'astro:assets';
import hero from '../assets/images/photo-hero-grappling.jpg';
import CtaArrow from './CtaArrow.astro';
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero__photo">
    <Image
      src={hero}
      alt="Партерна боротьба на змаганнях Львівської федерації рукопашного бою"
      widths={[640, 1000]}
      sizes="(min-width: 768px) 72vw, 100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <i class="gl gl--left" aria-hidden="true"></i>
  <i class="gl gl--right" aria-hidden="true"></i>

  <div class="container hero__inner">
    <h1 id="hero-title" class="display hero__title">
      Рукопашний
      <br />
      <span class="outline">бій</span> у&nbsp;Львові
    </h1>
    <div class="hero__foot">
      <p class="hero__lead">
        Сильне тіло, ясна голова й упевненість у собі. Рукопашний бій для дорослих і дітей: стійка,
        партер, кидки, крок за кроком від першого заняття до чорного пояса. Приходьте
        з&nbsp;досвідом чи&nbsp;без.
      </p>
      <div class="hero__cta">
        <CtaArrow href="#training">Знайти свій зал</CtaArrow>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line-subtle);
    background:
      radial-gradient(
        80% 40% at 90% 0%,
        color-mix(in srgb, var(--blue) 35%, transparent),
        transparent 70%
      ),
      var(--bg-base);
  }

  .hero__photo {
    position: absolute;
    inset: 0 0 auto;
    height: 380px;
    mask-image: linear-gradient(180deg, var(--black) 55%, transparent 100%);
  }

  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: drift 24s ease-in-out infinite alternate;
  }

  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 55%,
      color-mix(in srgb, var(--bg-base) 70%, transparent)
    );
  }

  .gl {
    display: none;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    padding-top: 200px;
    padding-bottom: var(--space-7);
  }

  .hero__title {
    --outline-width: 1.5px;
    font-size: var(--fs-hero-title);
    line-height: 0.86;
    letter-spacing: -0.01em;
    text-shadow: 0 6px 24px color-mix(in srgb, var(--black) 60%, transparent);
    animation: lift 0.9s var(--ease) 0.1s both;
  }

  .hero__lead {
    margin: var(--space-5) 0 var(--space-6);
    padding-left: var(--space-4);
    border-left: 2px solid var(--yellow);
    color: var(--text);
    font-size: var(--fs-base);
    line-height: 1.55;
    text-wrap: pretty;
    animation: rise 0.8s var(--ease) 0.45s both;
  }

  .hero__cta {
    animation: rise 0.8s var(--ease) 0.6s both;
  }

  @keyframes drift {
    from {
      transform: scale(1.02);
    }

    to {
      transform: scale(1.09) translateX(-1.5%);
    }
  }

  @keyframes scan {
    from {
      top: -180px;
    }

    to {
      top: 100%;
    }
  }

  @keyframes lift {
    from {
      transform: translateY(22px);
    }

    to {
      transform: none;
    }
  }

  @media (min-width: 768px) {
    .hero__photo {
      inset: 0 0 0 auto;
      width: 72%;
      height: auto;
      mask-image: linear-gradient(90deg, transparent 0, var(--black) 38%);
    }

    .hero {
      background:
        radial-gradient(
          60% 90% at 85% 10%,
          color-mix(in srgb, var(--blue) 35%, transparent),
          transparent 70%
        ),
        var(--bg-base);
    }

    .gl {
      position: absolute;
      inset-block: 0;
      display: block;
      width: 3px;
      background: color-mix(in srgb, var(--text) 8%, transparent);
    }

    .gl::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      top: 0;
      height: 180px;
      background: linear-gradient(180deg, transparent, var(--yellow), transparent);
      opacity: 0.8;
      animation: scan 9s ease-in-out infinite;
    }

    .gl--right::after {
      animation-delay: -4.5s;
    }

    .gl--left {
      left: var(--gutter);
    }

    .gl--right {
      right: var(--gutter);
    }

    .hero__inner {
      padding-top: clamp(80px, 8vw, 110px);
      padding-bottom: var(--space-9);
    }

    .hero__title {
      --outline-width: 2px;
      font-size: var(--fs-hero-title-lg);
      min-height: clamp(260px, 29vw, 430px);
    }

    .hero__foot {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-8);
    }

    .hero__lead {
      max-width: var(--measure-md);
      margin: 0;
      padding-left: var(--space-5);
      font-size: var(--fs-lg);
    }
  }
</style>
